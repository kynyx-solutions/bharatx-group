# Local: a SQLite file.
DATABASE_URL=file:./bharatx.db

# Hosted (Vercel): Turso, from the Vercel marketplace (it sets these two for you)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Hosted (Vercel): Vercel Blob store for uploads (set by Vercel when the store is connected)
BLOB_READ_WRITE_TOKEN=
PAYLOAD_SECRET=generate-with-openssl-rand-hex-32
NEXT_PUBLIC_SITE_URL=https://bharatxgroup.org
# Payload's own address (admin and API). Leave empty locally and for previews.
PAYLOAD_SERVER_URL=https://bharatxgroup.org
# Optional: password-protect a preview (see src/proxy.ts)
PREVIEW_PASSWORD=

# Optional until launch: form notification emails (Resend)
RESEND_API_KEY=
EMAIL_FROM=BharatX Group <no-reply@bharatxgroup.org>
